Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect application source, configuration, and repository metadata.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,NC,L]
    RewriteRule ^(?:app|config|database|routes|views|storage|scratch|printer_service|vendor|node_modules)(?:/|$) - [F,NC,L]
    RewriteRule ^(?:\.env(?:\..*)?|\.git|\.svn|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml(?:\.dist)?)(?:/|$) - [F,NC,L]
    RewriteRule \.(?:sql|ini|log|md|ya?ml|bak|backup|dist|example)$ - [F,NC,L]
    RewriteRule ^[^/]+\.pdf$ - [F,NC,L]

    # Do not expose implementation PHP files directly; the front controllers remain reachable.
    RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]) [NC]
    RewriteCond %{REQUEST_URI} !/(?:public/)?index\.php$ [NC]
    RewriteRule ^ - [F,L]

    # Serve public assets and uploads when the repository root is the document root.
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    # Route application URLs through the public front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml font/woff2 font/woff
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>
